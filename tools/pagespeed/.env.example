# Copie para .env (nunca commitado) e preencha com sua chave real.
# Como obter: console.cloud.google.com -> APIs & Services -> habilitar
# "PageSpeed Insights API" (e opcionalmente "Chrome UX Report API") ->
# Credentials -> criar API key. Restrinja a chave a essas APIs.
GOOGLE_PAGESPEED_API_KEY=

# Opcionais -- defaults ja cobrem o uso normal.
# GOOGLE_PAGESPEED_TIMEOUT_SECONDS=30
# GOOGLE_PAGESPEED_API_HOST=www.googleapis.com
# GOOGLE_CRUX_API_HOST=chromeuxreport.googleapis.com
