# Copie para .env (nunca commitado -- ver .gitignore) e preencha com os
# valores reais obtidos seguindo o README.md, secao "Setup Meta".

# Access token de usuario do Instagram (Instagram API with Instagram Login).
# Nunca cole isto em chat, issue, PR ou qualquer lugar publico.
INSTAGRAM_ACCESS_TOKEN=

# IG User ID da conta profissional (Business/Creator) do Trevo Digital
# Conversoes, obtido via GET /me depois de autenticar.
INSTAGRAM_USER_ID=

# Opcional -- defaults ja documentados em src/trevo_instagram/config.py
# INSTAGRAM_API_HOST=graph.instagram.com
# INSTAGRAM_API_VERSION=v26.0
# INSTAGRAM_TIMEOUT_SECONDS=20

# Trava mestra de publicacao real. Precisa estar em "1" E o comando
# `publish` precisa receber --confirm-publish -- as DUAS coisas, ou a
# publicacao e bloqueada antes de qualquer chamada de rede mutavel.
# Deixe em branco/0 exceto no momento exato em que for publicar de verdade.
INSTAGRAM_ALLOW_PUBLISH=0
