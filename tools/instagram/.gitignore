# Segredos locais -- nunca commitar
.env
.env.*
!.env.example

# Estado/saida local de execucao -- nunca commitar
.instagram-state/
.instagram-output/

# Manifestos pessoais de teste (ex.: com media_url apontando para uma
# branch/URL especifica que fica obsoleta apos merge) -- nao sao a
# configuracao canonica do post, cada dev pode ter o seu.
manifests/*.local.toml

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
