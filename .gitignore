# Variáveis de ambiente locais — nunca commitar segredos, tokens, chaves, cookies, sessões ou credenciais
.env
.env.*
!.env.example

node_modules/
dist/

# Configuração local de ferramenta (Claude Code) — não faz parte do site
.claude/

# tools/instagram/ — estado e saída de execução local, nunca commitados
tools/instagram/.instagram-state/
tools/instagram/.instagram-output/
tools/instagram/**/__pycache__/
tools/instagram/.pytest_cache/
tools/instagram/**/*.pyc

# tools/pagespeed/ — evidencia bruta de execucao local (JSONs grandes,
# 100% reproduzivel rodando a ferramenta de novo — ver tools/pagespeed/README.md)
/evidencias/
tools/pagespeed/**/__pycache__/
tools/pagespeed/.pytest_cache/
tools/pagespeed/**/*.pyc
tools/pagespeed/**/*.egg-info/
